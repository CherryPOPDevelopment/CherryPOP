{
  "name": "aurelia-contacts",
  "version": "1.0.0",
  "description": "A modern contact manager with friend system and shared contact info",
  "main": "electron-main.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "electron": "electron .",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "icons": "node create-icons.js",
    "build": "npm run icons && electron-builder",
    "build:win": "npm run icons && electron-builder --win",
    "build:mac": "npm run icons && electron-builder --mac",
    "build:linux": "npm run icons && electron-builder --linux",
    "build:all": "npm run icons && electron-builder -mwl",
    "dist": "npm run build",
    "pack": "npm run icons && electron-builder --dir",
    "setup-db": "node backend/setup-mysql.js",
    "migrate": "node backend/migrate-database.js",
    "seed": "node backend/seed-database.js"
  },
  "keywords": [
    "contact-manager",
    "contacts",
    "friends",
    "sharing"
  ],
  "author": "Aurelia Contacts",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.4.0",
    "nodemailer": "^7.0.12",
    "uuid": "^9.0.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.0.2",
    "png2icons": "^2.0.1",
    "sharp": "^0.34.5",
    "to-ico": "^1.0.1"
  },
  "build": {
    "appId": "com.aureliacontacts.app",
    "productName": "Aurelia Contacts",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!docs/**/*",
      "!.git/**/*",
      "!*.md",
      "!.env.example",
      "!*.log",
      "!railway.json",
      "!Procfile",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "frontend/images/aureliajellyfish.jpg",
        "to": "images/"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
