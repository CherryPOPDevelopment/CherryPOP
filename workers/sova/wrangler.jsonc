{
  "$schema": "https://developers.cloudflare.com/wrangler/config-schema.json",
  "name": "cherrypop-sova",
  "main": "index.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "sova.cherrypopdevelopment.com",
      "custom_domain": true
    }
  ],
  "define": {
    "__dirname": "\"/\"",
    "process.versions.node": "undefined"
  },
  "build": {
    "command": "node scripts/build-views.js"
  },
  "assets": {
    "directory": "../../SOVA-demo/frontend/public",
    "binding": "ASSETS",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cherrypop",
      "database_id": "37c2ded3-f833-414e-9678-9fa0f0eb855f"
    }
  ]
}
