<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audit & Monitoring - SOVA Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="container audit-page">
    <div class="events-page-header" style="margin-bottom:2rem;">
      <div>
        <h1>Audit & Monitoring</h1>
        <p style="color:var(--muted);margin-top:0.25rem;">Review platform health, governance changes, and the latest high-signal guest and content activity.</p>
      </div>
      <a href="/admin" class="btn btn-secondary btn-sm">← Back to Workspace</a>
    </div>

    <section class="audit-summary-grid">
      <article class="audit-summary-card audit-summary-card-accent">
        <span class="audit-summary-label">Reservations</span>
        <strong><%= monitoringSnapshot.reservationTotal %></strong>
        <p>Total reservation records currently stored across the platform.</p>
      </article>
      <article class="audit-summary-card">
        <span class="audit-summary-label">Pending</span>
        <strong><%= monitoringSnapshot.pendingReservations %></strong>
        <p>Reservations still waiting on operational follow-through.</p>
      </article>
      <article class="audit-summary-card">
        <span class="audit-summary-label">Confirmed</span>
        <strong><%= monitoringSnapshot.confirmedReservations %></strong>
        <p>Reservations already approved and moving toward fulfillment.</p>
      </article>
      <article class="audit-summary-card">
        <span class="audit-summary-label">Access Changes</span>
        <strong><%= monitoringSnapshot.weeklyAccessChanges %></strong>
        <p>Governance changes recorded during the last 7 days.</p>
      </article>
    </section>

    <section class="audit-command-bar">
      <div>
        <h2>Operational Monitoring</h2>
        <p>The dashboard now prioritizes summary signals and recent high-value changes so admins can spot issues faster without loading oversized audit tables.</p>
      </div>
      <div class="audit-command-bar-notes">
        <span class="badge-status badge-admin">Governance Feed</span>
        <span class="badge-status badge-city">Content Monitoring</span>
        <span class="badge-status badge-approved">Reservation Health</span>
      </div>
    </section>

    <section class="audit-layout">
      <div class="audit-column audit-column-primary">
        <article class="audit-panel">
          <div class="audit-panel-head">
            <div>
              <h2>Monitoring Snapshot</h2>
              <p>Current environment and throughput indicators for quick administrative review.</p>
            </div>
          </div>

          <div class="audit-monitor-grid">
            <div class="audit-monitor-card">
              <strong><%= monitoringSnapshot.contentUpdates24h %></strong>
              <span>Content updates in the last 24 hours</span>
            </div>
            <div class="audit-monitor-card">
              <strong><%= monitoringSnapshot.enabledCities %></strong>
              <span>Enabled cities currently available</span>
            </div>
            <div class="audit-monitor-card">
              <strong><%= monitoringSnapshot.port %></strong>
              <span>Active application port</span>
            </div>
            <div class="audit-monitor-card">
              <strong><%= monitoringSnapshot.nodeEnv %></strong>
              <span>Node environment</span>
            </div>
          </div>

          <div class="audit-status-grid">
            <div class="audit-status-pill">
              <span>Pending</span>
              <strong><%= monitoringSnapshot.statusBreakdown.pending %></strong>
            </div>
            <div class="audit-status-pill">
              <span>Confirmed</span>
              <strong><%= monitoringSnapshot.statusBreakdown.confirmed %></strong>
            </div>
            <div class="audit-status-pill">
              <span>Cancelled</span>
              <strong><%= monitoringSnapshot.statusBreakdown.cancelled %></strong>
            </div>
            <div class="audit-status-pill">
              <span>Completed</span>
              <strong><%= monitoringSnapshot.statusBreakdown.completed %></strong>
            </div>
          </div>
        </article>

        <article class="audit-panel">
          <div class="audit-panel-head">
            <div>
              <h2>Governance Audit Feed</h2>
              <p>Latest access and policy changes affecting staff accounts and scope.</p>
            </div>
          </div>

          <% if (!accessAuditRows.length) { %>
            <div class="audit-empty-state">
              <strong>No governance changes recorded yet.</strong>
              <p class="muted-text">Role and scope updates will appear here once administrators start modifying access.</p>
            </div>
          <% } else { %>
            <div class="audit-feed-list">
              <% accessAuditRows.forEach((entry) => { %>
                <article class="audit-feed-item">
                  <div class="audit-feed-head">
                    <strong><%= entry.change_summary %></strong>
                    <span><%= new Date(entry.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
                  </div>
                  <p>Target: <strong><%= entry.target_username || 'Deleted account' %></strong> • Updated by <strong><%= entry.actor_username || 'Unknown admin' %></strong></p>
                  <div class="audit-badge-row">
                    <span class="badge-status badge-<%= entry.new_role || 'user' %>"><%= entry.old_role || 'none' %> → <%= entry.new_role || 'none' %></span>
                    <% if (entry.old_primary_city || entry.new_primary_city) { %>
                      <span class="badge-status badge-city"><%= entry.old_primary_city || 'none' %> → <%= entry.new_primary_city || 'none' %></span>
                    <% } %>
                    <% if (entry.old_allowed_cities || entry.new_allowed_cities) { %>
                      <span class="badge-status badge-city-soft"><%= entry.old_allowed_cities || 'none' %> → <%= entry.new_allowed_cities || 'none' %></span>
                    <% } %>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </article>
      </div>

      <div class="audit-column audit-column-secondary">
        <article class="audit-panel">
          <div class="audit-panel-head">
            <div>
              <h2>Recent Reservations</h2>
              <p>The latest guest reservation activity, trimmed to the highest-signal recent records.</p>
            </div>
          </div>

          <% if (!recentReservations.length) { %>
            <div class="audit-empty-state">
              <strong>No reservations on record.</strong>
              <p class="muted-text">Reservation activity will populate here once event bookings are created.</p>
            </div>
          <% } else { %>
            <div class="audit-reservation-list">
              <% recentReservations.forEach((entry) => { %>
                <article class="audit-reservation-item">
                  <div class="audit-feed-head">
                    <strong><%= entry.event_title %></strong>
                    <span><%= new Date(entry.reserved_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
                  </div>
                  <p><strong><%= entry.guest_username %></strong> • <%= entry.guest_email %></p>
                  <div class="audit-badge-row">
                    <span class="badge-status badge-<%= entry.status %>"><%= entry.status %></span>
                    <span class="badge-status badge-user"><%= entry.guest_count %> guest<%= entry.guest_count === 1 ? '' : 's' %></span>
                    <span class="badge-status badge-city-soft"><%= new Date(entry.start_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                  </div>
                  <% if (entry.notes) { %>
                    <p class="audit-feed-note"><%= entry.notes %></p>
                  <% } %>
                </article>
              <% }) %>
            </div>
          <% } %>
        </article>

        <article class="audit-panel">
          <div class="audit-panel-head">
            <div>
              <h2>Recent Content Activity</h2>
              <p>Newest event and recommendation updates merged into one stream for quicker monitoring.</p>
            </div>
          </div>

          <% if (!contentActivity.length) { %>
            <div class="audit-empty-state">
              <strong>No content activity yet.</strong>
              <p class="muted-text">Recently updated places and events will appear here.</p>
            </div>
          <% } else { %>
            <div class="audit-feed-list">
              <% contentActivity.forEach((entry) => { %>
                <article class="audit-feed-item">
                  <div class="audit-feed-head">
                    <strong><%= entry.title %></strong>
                    <span><%= new Date(entry.updated_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></span>
                  </div>
                  <p><strong><%= entry.type === 'event' ? 'Event' : 'Recommendation' %></strong> • <%= entry.category %> • by <strong><%= entry.author %></strong></p>
                  <div class="audit-badge-row">
                    <% if (entry.sublabel) { %>
                      <span class="badge-status badge-city"><%= new Date(entry.sublabel).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                    <% } %>
                    <a href="<%= entry.href %>" class="btn btn-secondary btn-sm">Open</a>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>
        </article>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
