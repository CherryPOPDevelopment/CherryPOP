<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Event - Hotel Concierge</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  
  <main class="container">
    <div class="form-container">
      <h1>Edit Event</h1>
      
      <% if (typeof message !== 'undefined') { %>
        <div class="alert alert-error"><%= message %></div>
      <% } %>

      <% const eventData = event || {}; %>

      <form method="POST" action="/events/<%= event.id %>/update?_method=PUT" id="event-form">
        <div class="form-group">
          <label for="title">Event Title *</label>
          <input type="text" id="title" name="title" value="<%= event.title %>" required>
        </div>

        <div class="form-group">
          <label for="category">Category *</label>
          <select id="category" name="category" required>
            <option value="Concert" <% if (event.category === 'Concert') { %>selected<% } %>>Concert</option>
            <option value="Conference" <% if (event.category === 'Conference') { %>selected<% } %>>Conference</option>
            <option value="Dinner" <% if (event.category === 'Dinner') { %>selected<% } %>>Dinner</option>
            <option value="Workshop" <% if (event.category === 'Workshop') { %>selected<% } %>>Workshop</option>
            <option value="Networking" <% if (event.category === 'Networking') { %>selected<% } %>>Networking</option>
            <option value="Speakeasy" <% if (event.category === 'Speakeasy') { %>selected<% } %>>Speakeasy</option>
            <option value="Other" <% if (event.category === 'Other') { %>selected<% } %>>Other</option>
          </select>
        </div>

        <div class="form-group">
          <label for="description">Description *</label>
          <textarea id="description" name="description" rows="6" required><%= event.description %></textarea>
        </div>

        <div class="form-group">
          <label for="location">Location/Venue *</label>
          <input type="text" id="location" name="location" value="<%= eventData.location %>" required>
        </div>

        <div class="form-group">
          <label for="tags">Event Tags</label>
          <input type="text" id="tags" name="tags" value="<%= eventData.tags || '' %>" placeholder="music, rooftop, brunch, family-friendly">
          <small class="form-hint">Comma-separated tags make events easier to discover.</small>
        </div>

        <div class="form-group">
          <label for="related_place_id">Link To Recommendation</label>
          <select id="related_place_id" name="related_place_id">
            <option value="">No linked recommendation</option>
            <% (placeOptions || []).forEach((placeOption) => { %>
              <option value="<%= placeOption.id %>" <%= String(eventData.related_place_id || '') === String(placeOption.id) ? 'selected' : '' %>>
                <%= placeOption.title %> (<%= placeOption.location %>)
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="related_place_relation">Recommendation Relationship</label>
          <select id="related_place_relation" name="related_place_relation">
            <option value="">Select relationship (optional)</option>
            <option value="at" <%= String(eventData.related_place_relation || '').toLowerCase() === 'at' ? 'selected' : '' %>>At this recommendation location</option>
            <option value="by" <%= String(eventData.related_place_relation || '').toLowerCase() === 'by' ? 'selected' : '' %>>By this recommendation (hosted/organized)</option>
          </select>
          <small class="form-hint">Use this when the event happens at or is hosted by a listed recommendation.</small>
        </div>

        <div class="form-group">
          <label for="recurrence_type">Event Type *</label>
          <select id="recurrence_type" name="recurrence_type" required>
            <option value="one_time" <% if ((event.recurrence_type || 'one_time') === 'one_time') { %>selected<% } %>>One-time (auto hide after next day)</option>
            <option value="recurring" <% if (event.recurrence_type === 'recurring') { %>selected<% } %>>Recurring (stays listed permanently)</option>
          </select>
        </div>

        <div id="one-time-fields" class="form-group">
          <label for="event_date">Event Date *</label>
          <input type="date" id="event_date" name="event_date" value="<%= toDateInput(event.start_at) %>" required>
        </div>

        <div id="recurring-fields" class="form-group" style="display:none;">
          <label>Days of Week *</label>
          <% const recurringDays = (eventData.recurring_days || '').split(','); %>
          <div class="weekday-grid">
            <label><input type="checkbox" name="recurring_days[]" value="mon" <%= recurringDays.includes('mon') ? 'checked' : '' %>> Mon</label>
            <label><input type="checkbox" name="recurring_days[]" value="tue" <%= recurringDays.includes('tue') ? 'checked' : '' %>> Tue</label>
            <label><input type="checkbox" name="recurring_days[]" value="wed" <%= recurringDays.includes('wed') ? 'checked' : '' %>> Wed</label>
            <label><input type="checkbox" name="recurring_days[]" value="thu" <%= recurringDays.includes('thu') ? 'checked' : '' %>> Thu</label>
            <label><input type="checkbox" name="recurring_days[]" value="fri" <%= recurringDays.includes('fri') ? 'checked' : '' %>> Fri</label>
            <label><input type="checkbox" name="recurring_days[]" value="sat" <%= recurringDays.includes('sat') ? 'checked' : '' %>> Sat</label>
            <label><input type="checkbox" name="recurring_days[]" value="sun" <%= recurringDays.includes('sun') ? 'checked' : '' %>> Sun</label>
          </div>
          <small class="form-hint">Select at least one day for recurring events.</small>
        </div>

        <div class="form-group">
          <label for="start_time">Start Time *</label>
          <input type="time" id="start_time" name="start_time" value="<%= toTimeInput(event.start_at) || '19:00' %>" required>
        </div>

        <div class="form-group">
          <label for="end_time">End Time</label>
          <input type="time" id="end_time" name="end_time" value="<%= toTimeInput(event.end_at) %>">
        </div>

        <div class="form-group">
          <label for="capacity">Capacity (number of guests) *</label>
          <input type="number" id="capacity" name="capacity" min="1" value="<%= event.capacity %>" required>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Update Event</button>
          <a href="/events/<%= event.id %>" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </main>

  <script>
    const form = document.getElementById('event-form');
    const recurrenceType = document.getElementById('recurrence_type');
    const oneTimeFields = document.getElementById('one-time-fields');
    const recurringFields = document.getElementById('recurring-fields');
    const eventDate = document.getElementById('event_date');

    function updateScheduleFields() {
      const recurring = recurrenceType.value === 'recurring';
      oneTimeFields.style.display = recurring ? 'none' : 'block';
      recurringFields.style.display = recurring ? 'block' : 'none';
      eventDate.required = !recurring;
    }

    recurrenceType.addEventListener('change', updateScheduleFields);
    updateScheduleFields();

    form.addEventListener('submit', function (event) {
      if (recurrenceType.value !== 'recurring') {
        return;
      }

      const checkedDays = document.querySelectorAll('input[name="recurring_days[]"]:checked');
      if (checkedDays.length < 1) {
        event.preventDefault();
        alert('Please select at least one day of the week for recurring events.');
      }
    });
  </script>

  <%- include('../partials/footer') %>
</body>
</html>
